# Build output — regenerated by `npm run build` / the GitHub Actions workflow.
_site/
src/assets/css/site.css

# Dependencies
node_modules/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp

# Secrets / local-only (same rule as before — nothing here reaches the repo)
local-only/
github-token.txt
*token*.txt
*.pem
*.key
.env
.env.*
env-local-notes.txt
*secrets*

# Backups / temp files
*.bak
*.tmp
*~

# Staged for manual deletion — the device shell can't delete files directly,
# so cleanup passes (legacy pre-refactor files, orphaned duplicates) move
# things here instead of removing them. Safe to empty this folder yourself
# any time; git never sees what's inside it.
_to_delete/
