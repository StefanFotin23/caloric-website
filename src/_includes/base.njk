<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">

<!-- SEO pass (2026-08-30): canonical + Open Graph/Twitter + JSON-LD.
     site.baseUrl is the single source of truth for the deployed URL (see
     src/_data/site.js) — update it there once, not in 3 places, when
     caloric.ro's DNS is recovered and wired up. -->
<link rel="canonical" href="{{ site.baseUrl }}/{{ permalink }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.companyName }}">
<meta property="og:locale" content="ro_RO">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.baseUrl }}/{{ permalink }}">
<meta property="og:image" content="{{ site.baseUrl }}/{{ site.ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.baseUrl }}/{{ site.ogImage }}">

<!-- JSON-LD LocalBusiness (HVACBusiness subtype) — name/address/phone/hours
     for local-search rich results. Deliberately NO aggregateRating here:
     Google's structured-data guidelines discourage a star-rating snippet
     unless the reviews are genuinely shown on-page (not just copied from
     the Google Maps listing) — risks the rich result being ignored, or
     worse, a manual action for misleading markup. Revisit if real reviews
     ever get displayed on the site itself. -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  "name": "{{ site.companyName }}",
  "image": "{{ site.baseUrl }}/{{ site.ogImage }}",
  "url": "{{ site.baseUrl }}/",
  "telephone": "{{ site.phone }}",
  "email": "{{ site.email }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Bd. Dorobanților 466",
    "addressLocality": "Brăila",
    "postalCode": "810091",
    "addressCountry": "RO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 45.2559,
    "longitude": 27.9617
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "17:00"
    }
  ],
  "sameAs": ["{{ site.facebookUrl }}"],
  "areaServed": [
    {% for county in site.areaServed %}
    { "@type": "AdministrativeArea", "name": "{{ county }}" }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicii Caloric",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Climatizare", "areaServed": "Brăila" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Încălzire și Pompe de Căldură", "areaServed": "Brăila" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ventilație cu Recuperare de Căldură", "areaServed": "Brăila" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Refrigerare Comercială și Industrială", "areaServed": "Brăila" } }
    ]
  }
}
</script>

{% if breadcrumb %}
<!-- BreadcrumbList — added on partner pages only (see page front matter's
     `breadcrumb` array), helps crawlers understand daikin.html/value.html
     sit under the homepage rather than being orphaned pages. -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {% for b in breadcrumb %}
    { "@type": "ListItem", "position": {{ loop.index }}, "name": "{{ b.name }}", "item": "{{ site.baseUrl }}/{{ b.url }}" }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

<!-- color-scheme: light dark + real dark: styling (see tailwind.config.js
     and assets/css/site.css) tells browsers/OSes with dark mode (Android
     auto-dark, Samsung Internet's forced-dark, etc.) that this page has its
     own real dark styling — so they render that instead of algorithmically
     force-darkening the page themselves, which is what broke contrast
     (logos especially) before this was fixed. -->
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0f1a2e" media="(prefers-color-scheme: dark)">

<link rel="icon" type="image/png" href="assets/favicon.png">
<link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
<link rel="manifest" href="manifest.webmanifest">
<meta name="apple-mobile-web-app-title" content="{{ site.companyName }}">
<meta name="apple-mobile-web-app-capable" content="yes">

<!-- Compiled by Tailwind CLI at build time (npm run build) from src/css/input.css
     + tailwind.config.js — no more Play CDN, no more client-side compiling.
     Inter is self-hosted inside this file too (see src/css/input.css) —
     no more fonts.googleapis.com/fonts.gstatic.com request, so no visitor
     IP goes to Google before consent (GDPR pass, 2026-08-30). -->
<link rel="stylesheet" href="assets/css/site.css">

<!-- Font Awesome: self-hosted subset, compiled into site.css above
     (2026-08-30, see the comment block in src/css/input.css) — the CDN
     stylesheet link that used to be here is gone. -->
</head>
<body class="bg-white text-ice-950 dark:text-ice-50 antialiased dark:bg-ice-950" data-page="{{ pageLabel }}">

<a href="#main-content" class="skip-link">Sari la conținut</a>

{% include "partials/nav.njk" %}

<main id="main-content">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}
{% include "partials/whatsapp-float.njk" %}
{% include "partials/product-modal.njk" %}
{% include "partials/consent-banner.njk" %}

<script src="assets/site.js" defer></script>
<!-- Web3Forms client script (renders the hCaptcha widget) is lazy-loaded from
     site.js once the visitor actually scrolls to #contact — see the
     "hCaptcha lazy-load" block there — instead of on every single page
     view regardless of whether they ever reach the form. -->
</body>
</html>
