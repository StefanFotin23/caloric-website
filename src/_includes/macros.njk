{#
  productCard(card, delay) — the card markup used by every service/product
  grid on all 3 pages (11 times on index.html, 3 on daikin.html). Previously
  this exact block of markup was hand-copied 17 times; now it's written once.

  `card` needs: title, shortText, image, imageAlt.
  Optional: modalText + modalImages — when present, the card becomes
  clickable and opens the shared product-modal (see partials/product-modal.njk
  + assets/site.js). Cards without modalText render as plain, non-clickable
  cards — this is what keeps value.html's "Ce Avem pe Stoc" cards exactly as
  they are today (no invented modal copy for them, see delivery notes).

  Titles/text go through plain {{ }} output (not `| safe`) on purpose: Nunjucks
  auto-escapes special characters for us, so a title like "Sisteme
  Industriale & Chillere" always renders as valid HTML — this is what
  prevents the class of bug we hand-fixed once already this project (an
  unescaped & inside a hand-written attribute).
#}
{% macro productCard(card, delay=0) %}
{% set interactive = card.modalText | default(false) %}
{% set webp = card.image | webpSrc %}
<div class="reveal group bg-white border border-ice-100 dark:bg-ice-900 dark:border-ice-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300{% if interactive %} product-card cursor-pointer{% endif %}"{% if delay %} style="transition-delay: {{ delay }}ms;"{% endif %}{% if interactive %} role="button" tabindex="0" aria-haspopup="dialog" data-modal-title="{{ card.title }}" data-modal-text="{{ card.modalText }}" data-modal-images='{{ (card.modalImages or []) | dump | safe }}'{% endif %}>
  {%- if webp %}
  <picture>
    <source srcset="{{ webp }}" type="image/webp">
    <img src="{{ card.image }}" alt="{{ card.imageAlt }}" loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover">
  </picture>
  {%- else %}
  <img src="{{ card.image }}" alt="{{ card.imageAlt }}" loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover">
  {%- endif %}
  <div class="p-5">
    <h4 class="font-bold text-ice-950 dark:text-ice-50">{{ card.title }}</h4>
    <p class="mt-2 text-sm text-ice-900/70 dark:text-ice-100/70 leading-relaxed">{{ card.shortText }}</p>
    {%- if interactive %}
    <p class="mt-3 text-xs font-semibold text-ice-700 dark:text-ice-300 group-hover:text-ice-800 dark:group-hover:text-ice-300 inline-flex items-center gap-1.5">Vezi detalii <i aria-hidden="true" class="fa-solid fa-arrow-right text-[10px]"></i></p>
    {%- endif %}
  </div>
</div>
{% endmacro %}
