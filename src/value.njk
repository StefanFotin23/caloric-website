{% import "macros.njk" as m %}

<!-- ============================= -->
<!-- HERO                          -->
<!-- ============================= -->
<section class="value-hero relative flex items-center min-h-[70vh] pt-16 md:pt-20">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 w-full">
    <div class="max-w-2xl">
      <span class="inline-flex items-center bg-white px-4 py-2 rounded-lg mb-6 shadow-sm">
        <img src="assets/logo-value.png" alt="Sigla Value" class="h-6 w-auto object-contain">
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
        Distribuitor Unic <span class="text-ember-300">Value</span> pentru Brăila &amp; Galați
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-ice-100/90 max-w-xl">
        Acces direct la stocul Value — echipamente disponibile rapid, prețuri competitive și acoperire pe toată regiunea Brăila-Galați.
      </p>
      <div class="mt-9 flex flex-col sm:flex-row gap-4">
        <a href="index.html#contact" class="inline-flex items-center justify-center gap-2 bg-ember-500 hover:bg-ember-600 text-white font-semibold text-lg px-8 py-4 rounded-xl shadow-lg shadow-ember-900/30 transition-all hover:-translate-y-0.5">
          <i class="fa-solid fa-bolt"></i> Cere Ofertă Gratuită
        </a>
        <a href="index.html" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold text-lg px-8 py-4 rounded-xl backdrop-blur-sm transition-all">
          <i class="fa-solid fa-arrow-left"></i> Înapoi la Caloric
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ============================= -->
<!-- DE CE VALUE                   -->
<!-- ============================= -->
<section class="py-20 sm:py-28 bg-white dark:bg-ice-950">
  <div class="max-w-7xl mx-auto px-5 sm:px-8">
    <div class="max-w-2xl mx-auto text-center reveal">
      <span class="text-ember-500 font-semibold uppercase tracking-wider text-sm">De Ce Value</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-ice-950 dark:text-ice-50">Stoc, Preț și Acoperire Regională</h2>
      <p class="mt-4 text-ice-900/70 dark:text-ice-100/70 text-lg">
        Fiind distribuitor oficial Value pentru Brăila și Galați, avem acces direct la stocul furnizorului — fără intermediari și fără așteptare inutilă.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="reveal bg-white border border-ice-100 dark:bg-ice-900 dark:border-ice-800 rounded-2xl p-7 shadow-sm text-center">
        <i class="fa-solid fa-warehouse text-3xl text-ember-500 mb-4"></i>
        <h3 class="font-bold text-ice-950 dark:text-ice-50">Acces Rapid la Stoc</h3>
        <p class="mt-2 text-sm text-ice-900/70 dark:text-ice-100/70 leading-relaxed">Echipamente disponibile direct din stocul de distribuitor, fără termene lungi de așteptare.</p>
      </div>
      <div class="reveal bg-white border border-ice-100 dark:bg-ice-900 dark:border-ice-800 rounded-2xl p-7 shadow-sm text-center" style="transition-delay: 80ms;">
        <i class="fa-solid fa-tags text-3xl text-ember-500 mb-4"></i>
        <h3 class="font-bold text-ice-950 dark:text-ice-50">Prețuri Competitive</h3>
        <p class="mt-2 text-sm text-ice-900/70 dark:text-ice-100/70 leading-relaxed">Fiind distribuitor oficial, oferim prețuri de la sursă, fără marje de intermediar.</p>
      </div>
      <div class="reveal bg-white border border-ice-100 dark:bg-ice-900 dark:border-ice-800 rounded-2xl p-7 shadow-sm text-center" style="transition-delay: 160ms;">
        <i class="fa-solid fa-map-location-dot text-3xl text-ember-500 mb-4"></i>
        <h3 class="font-bold text-ice-950 dark:text-ice-50">Acoperire Brăila &amp; Galați</h3>
        <p class="mt-2 text-sm text-ice-900/70 dark:text-ice-100/70 leading-relaxed">Livrare, instalare și service pe toată aria Brăila-Galați, cu echipa noastră proprie.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================= -->
<!-- GAMA DE PRODUSE VALUE         -->
<!-- ============================= -->
<section class="py-20 sm:py-28 bg-ice-50/60 dark:bg-ice-950">
  <div class="max-w-7xl mx-auto px-5 sm:px-8">
    <div class="max-w-2xl mx-auto text-center reveal">
      <span class="text-ice-600 dark:text-ice-300 font-semibold uppercase tracking-wider text-sm">Gama Value</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-ice-950 dark:text-ice-50">Ce Avem pe Stoc</h2>
    </div>

    <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for card in valueProducts %}
      {{ m.productCard(card, loop.index0 * 40) }}
      {% endfor %}
    </div>

    <p class="reveal mt-10 text-center text-ice-900/60 dark:text-ice-200/60">
      Vezi și restul serviciilor noastre în <a href="index.html#services" class="text-ice-600 dark:text-ice-300 font-semibold hover:underline">secțiunea Servicii</a>.
    </p>
  </div>
</section>

