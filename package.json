{
  "name": "caloric-website",
  "version": "1.0.0",
  "private": true,
  "description": "Site Caloric HVAC (Braila) — Eleventy + Tailwind CSS, deploy automat pe GitHub Pages via GitHub Actions.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./src/assets/css/site.css --minify",
    "build:eleventy": "eleventy",
    "build": "npm run build:css && npm run build:eleventy",
    "dev": "concurrently -n css,11ty -c blue,green \"npm:dev:css\" \"npm:dev:eleventy\"",
    "dev:css": "tailwindcss -i ./src/css/input.css -o ./src/assets/css/site.css --watch",
    "dev:eleventy": "eleventy --serve"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "concurrently": "^8.2.2",
    "tailwindcss": "^3.4.13"
  }
}
